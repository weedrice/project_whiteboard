{
  "name": "noviis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run pwa:verify",
    "build:seo": "npm run sitemap:generate && npm run build && npm run prerender:posts",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "pwa:verify": "node ./scripts/verify-pwa-budget.mjs",
    "prerender:posts": "node ./scripts/prerender-posts.mjs",
    "seo:verify": "node ./scripts/verify-seo.mjs",
    "seo:verify:dist": "node ./scripts/verify-prerender-output.mjs",
    "seo:submit": "node ./scripts/submit-search-engines.mjs",
    "sitemap:generate": "node ./scripts/generate-sitemap.mjs",
    "smoke:local": "node ./scripts/smoke-local.mjs",
    "check:ui": "node ./scripts/check-responsive-ui.mjs && node ./scripts/check-color-tokens.mjs",
    "check:colors": "node ./scripts/check-color-tokens.mjs",
    "check:i18n": "eslint \"src/**/*.vue\" --no-cache && vitest run src/locales/__tests__/messages.spec.ts src/locales/__tests__/keyUsage.spec.ts",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:full": "playwright test --config playwright.full.config.ts",
    "coverage": "vitest run --coverage && npm run coverage:focused",
    "coverage:focused": "node ./scripts/verify-focused-coverage.mjs",
    "lint": "eslint \"src/**/*.{ts,vue}\" --cache",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "lint:ci": "eslint \"src/**/*.{ts,vue}\" --max-warnings=0"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.91.4",
    "@tiptap/extension-code-block-lowlight": "3.27.4",
    "@tiptap/extension-color": "3.27.4",
    "@tiptap/extension-highlight": "3.27.4",
    "@tiptap/extension-horizontal-rule": "3.27.4",
    "@tiptap/extension-image": "3.27.4",
    "@tiptap/extension-link": "3.27.4",
    "@tiptap/extension-mention": "3.27.4",
    "@tiptap/extension-table": "3.27.4",
    "@tiptap/extension-table-cell": "3.27.4",
    "@tiptap/extension-table-header": "3.27.4",
    "@tiptap/extension-table-row": "3.27.4",
    "@tiptap/extension-text-align": "3.27.4",
    "@tiptap/extension-text-style": "3.27.4",
    "@tiptap/extension-underline": "3.27.4",
    "@tiptap/starter-kit": "3.27.4",
    "@tiptap/suggestion": "3.27.4",
    "@tiptap/vue-3": "3.27.4",
    "@types/dompurify": "^3.0.5",
    "@unhead/vue": "^3.1.8",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^0.554.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-i18n": "^11.2.2",
    "vue-router": "^5.2.0",
    "vuedraggable": "^4.1.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/loglevel": "^1.5.4",
    "@types/node": "^24.10.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/eslint-plugin": "^1.6.18",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.18",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.3.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "satori": "^0.26.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.1.11",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.15",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.1.8"
  }
}

    "@tiptap/vue-3": "^3.19.0",
    "@types/dompurify": "^3.0.5",
    "@unhead/vue": "^2.1.2",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "loglevel": "^1.9.2",
    "loglevel-plugin-prefix": "^0.8.4",

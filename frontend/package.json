    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/eslint-plugin": "^1.6.18",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.18",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.1",

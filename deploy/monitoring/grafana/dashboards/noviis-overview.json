    {"type":"timeseries","title":"Web Push delivery outcomes","id":18,"gridPos":{"h":8,"w":12,"x":0,"y":48},"targets":[{"expr":"sum by (outcome) (increase(noviis_webpush_delivery_total[15m]))","legendFormat":"{{outcome}} / 15m","refId":"A"},{"expr":"sum by (outcome) (increase(noviis_webpush_subscription_cleanup_total[15m]))","legendFormat":"cleanup {{outcome}} / 15m","refId":"B"}]},
    {"type":"timeseries","title":"Scheduler saturation and queue growth","id":19,"gridPos":{"h":8,"w":12,"x":12,"y":48},"targets":[{"expr":"max by (pool) (noviis_scheduler_pool_active) / clamp_min(max by (pool) (noviis_scheduler_pool_size), 1)","legendFormat":"{{pool}} utilization","refId":"A"},{"expr":"deriv(noviis_scheduler_pool_queued[10m])","legendFormat":"{{pool}} queue growth / second","refId":"B"}]}

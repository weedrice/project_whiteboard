{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {"type":"stat","title":"Backend up","id":1,"gridPos":{"h":4,"w":4,"x":0,"y":0},"targets":[{"expr":"up{job=\"noviis-backend\"}","refId":"A"}]},
    {"type":"gauge","title":"JVM heap %","id":2,"gridPos":{"h":4,"w":5,"x":4,"y":0},"fieldConfig":{"defaults":{"max":100,"min":0,"unit":"percent"}},"targets":[{"expr":"100 * sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"})","refId":"A"}]},
    {"type":"timeseries","title":"Process CPU","id":3,"gridPos":{"h":8,"w":7,"x":9,"y":0},"fieldConfig":{"defaults":{"unit":"percentunit"}},"targets":[{"expr":"process_cpu_usage","refId":"A"}]},
    {"type":"timeseries","title":"GC pause rate","id":4,"gridPos":{"h":8,"w":8,"x":16,"y":0},"targets":[{"expr":"rate(jvm_gc_pause_seconds_sum[5m])","refId":"A"}]},
    {"type":"timeseries","title":"Scheduler active and queued","id":5,"gridPos":{"h":8,"w":8,"x":0,"y":8},"targets":[{"expr":"noviis_scheduler_pool_active","legendFormat":"{{pool}} active","refId":"A"},{"expr":"noviis_scheduler_pool_queued","legendFormat":"{{pool}} queued","refId":"B"}]},
    {"type":"timeseries","title":"Scheduled job duration","id":6,"gridPos":{"h":8,"w":8,"x":8,"y":8},"fieldConfig":{"defaults":{"unit":"s"}},"targets":[{"expr":"rate(noviis_scheduler_execution_seconds_sum[5m]) / clamp_min(rate(noviis_scheduler_execution_seconds_count[5m]), 0.0001)","legendFormat":"{{job}} {{outcome}}","refId":"A"}]},
    {"type":"timeseries","title":"Semantic backlog","id":7,"gridPos":{"h":8,"w":8,"x":16,"y":8},"targets":[{"expr":"noviis_semantic_jobs_pending","legendFormat":"pending","refId":"A"},{"expr":"noviis_semantic_jobs_oldest_age_seconds","legendFormat":"oldest age seconds","refId":"B"}]},
    {"type":"timeseries","title":"SSE connections and heartbeat","id":8,"gridPos":{"h":8,"w":8,"x":0,"y":16},"targets":[{"expr":"noviis_sse_connections_active","legendFormat":"connections","refId":"A"},{"expr":"noviis_sse_heartbeat_gap_seconds","legendFormat":"heartbeat gap","refId":"B"},{"expr":"increase(noviis_sse_heartbeat_failures_total[5m])","legendFormat":"failures/5m","refId":"C"}]},
    {"type":"timeseries","title":"Rate limit rejections","id":9,"gridPos":{"h":8,"w":8,"x":8,"y":16},"targets":[{"expr":"sum by (tier) (increase(noviis_ratelimit_rejected_total[5m]))","legendFormat":"{{tier}}","refId":"A"}]},
    {"type":"timeseries","title":"Rate limit cache","id":10,"gridPos":{"h":8,"w":8,"x":16,"y":16},"targets":[{"expr":"noviis_ratelimit_cache_size","legendFormat":"{{scope}} size","refId":"A"},{"expr":"increase(noviis_ratelimit_cache_evictions_total[15m])","legendFormat":"{{scope}} evictions","refId":"B"}]},
    {"type":"timeseries","title":"Pending agent purge","id":11,"gridPos":{"h":8,"w":12,"x":0,"y":24},"targets":[{"expr":"noviis_agent_pending_claim_purge_eligible","legendFormat":"eligible","refId":"A"},{"expr":"increase(noviis_agent_pending_claim_purged_total[1h])","legendFormat":"purged/hour","refId":"B"}]},
    {"type":"timeseries","title":"Failures","id":12,"gridPos":{"h":8,"w":12,"x":12,"y":24},"targets":[{"expr":"increase(noviis_scheduler_execution_seconds_count{outcome=\"error\"}[5m])","legendFormat":"scheduler {{job}}","refId":"A"},{"expr":"increase(noviis_agent_pending_claim_purge_failures_total[5m])","legendFormat":"agent purge","refId":"B"}]}
